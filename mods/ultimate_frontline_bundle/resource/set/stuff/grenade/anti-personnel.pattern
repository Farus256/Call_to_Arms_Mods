{from "pattern throwable"
	{tag "fg antipersonnel_grenade"}
	{inventory {size 3 1}}
	{mass 0.6}

	{damage blastwave
		{energy 1.1}
		{area 3 6}
		{ground_interaction_radius 0.1} ;// value is multiplied by 2nd value of area to determine is blast is close enough to ground to trigger terrain fx
	}

	{special
		{PrepareTime 4.75}
		{PrepareCursor "grenade"}
		{mode detonate}
	}

	{throw
		; UFB realism: native non-story gametype conditions
{range 24.7}
(mod "gametype:battle_zones" {range 28.405})
(mod "gametype:ammunition" {range 28.405})
(mod "gametype:evacuation" {range 28.405})
(mod "gametype:frontlines" {range 28.405})
(mod "gametype:campaign_capture_the_flag" {range 28.405})  ;in-game 26m
		{startAngle 45}
		{spreading 0.1}
	}
	{possibleDamageRadius 1}
}