{from "pattern anti-personnel"
	{tag "size2"}		; Explosive filling - 0.165kg of TNT
	{entity "m43_splinter"}

	{damage add blastwave
		{energy 0.95}
		{area 4 10}
		{ground_interaction_radius 0} ;// value is multiplied by 2nd value of area to determine is blast is close enough to ground to trigger terrain fx
	}

	{throw
		; UFB realism: native non-story gametype conditions
{range 25.7}
(mod "gametype:battle_zones" {range 29.555})
(mod "gametype:ammunition" {range 29.555})
(mod "gametype:evacuation" {range 29.555})
(mod "gametype:frontlines" {range 29.555})
(mod "gametype:campaign_capture_the_flag" {range 29.555})  ;in-game 27m
	}

	{special
		{PrepareTime 4.5}
	}
}

