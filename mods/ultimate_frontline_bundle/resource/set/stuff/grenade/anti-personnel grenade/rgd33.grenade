{from "pattern anti-personnel"
	{tag "size1"}		; Explosive filling - 0.085kg of TNT
	{inventory {size 2 1}}
	{entity "rgd33"}
	{mass 0.75}

	{damage add blastwave
		{energy 0.70}
		{area 4 10}
		{ground_interaction_radius 0} ;// value is multiplied by 2nd value of area to determine is blast is close enough to ground to trigger terrain fx
	}
	{special
		{PrepareTime 3.6}
	}
	{throw
		; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {range 24.7})))))
(mod "gametype:battle_zones" {range 28.405})
(mod "gametype:ammunition" {range 28.405})
(mod "gametype:evacuation" {range 28.405})
(mod "gametype:frontlines" {range 28.405})
(mod "gametype:campaign_capture_the_flag" {range 28.405})  ;in-game 26m
	}
}