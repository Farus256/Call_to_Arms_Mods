(include "\set\small_firearms_accuracy.inc")

;/*=========================*/

(define "burst_short"
	{burst
		{short 5 1}			;// short burst shots on long distance, rand (+-)shots
		{long 7 1}				;// long burst shots on short distance, rand (+-)shots
		; UFB realism: native non-story gametype conditions
{rangeKoef 0.8}
(mod "gametype:battle_zones" {rangeKoef 0.533333})
(mod "gametype:ammunition" {rangeKoef 0.533333})
(mod "gametype:evacuation" {rangeKoef 0.533333})
(mod "gametype:frontlines" {rangeKoef 0.533333})
(mod "gametype:campaign_capture_the_flag" {rangeKoef 0.533333})			;// rangeKoef * aimRange = max long burst distance
	}
	; UFB realism: native non-story gametype conditions
{FiringTimeoutDistanceFactor
		{0.25 0.25}	;30m, 0.5s
		{0.5 0.5}	;60m, 1.0s
		{1.0 0.75}	;120m, 2.0s
	}
(mod "gametype:battle_zones" {FiringTimeoutDistanceFactor {0.166667 0.25} {0.333333 0.5} {0.666667 0.75}})
(mod "gametype:ammunition" {FiringTimeoutDistanceFactor {0.166667 0.25} {0.333333 0.5} {0.666667 0.75}})
(mod "gametype:evacuation" {FiringTimeoutDistanceFactor {0.166667 0.25} {0.333333 0.5} {0.666667 0.75}})
(mod "gametype:frontlines" {FiringTimeoutDistanceFactor {0.166667 0.25} {0.333333 0.5} {0.666667 0.75}})
(mod "gametype:campaign_capture_the_flag" {FiringTimeoutDistanceFactor {0.166667 0.25} {0.333333 0.5} {0.666667 0.75}})
)

