;SDL
{weapon_bullet
	{tag "rocketlauncher to_hand ap cannot_lie"}
	{inventory
		{size 8 2}
		{link_bone "gun_back"}
		{weight 100}
		{fsm "bazooka"}
	}

	{states
		{reload "reload-bazooka"}
		{unload "unload-bazooka"}
		{fire "fire-bazooka"}
		{aim "aim-bazooka"}
		{can_aim "can-aim-bazooka"}
	}

	{cursor "ironsights/bazooka"}
	{cursorReloading "gun_heat"}
	{foresight "foresight3"}
	{fillingVisible "rocket"}

	{preloaded}

	; UFB realism: native non-story gametype conditions
{range 70 70}
(mod "gametype:battle_zones" {range 105 105})
(mod "gametype:ammunition" {range 105 105})
(mod "gametype:evacuation" {range 105 105})
(mod "gametype:frontlines" {range 105 105})
(mod "gametype:campaign_capture_the_flag" {range 105 105})

	{curve "gun_std"}
	{AimingTolerance 3}

	{projectileDamageThreshold 1}

	("fire rate" rpm(6))
	("reload time" seconds(10))

	{gravity 0.75}

	{spreading 1.75
		{SpreadPower 2}
		{SpreadXYRatio 0.7}
		{SpreadYadjust 0}
		; UFB realism: native non-story gametype conditions
{radiusFunction
			0.0		0
			0.85	0.9
			1.0		1.3
			1.2		6
			2		30
		}
(mod "gametype:battle_zones" {radiusFunction 0 0 0.566667 0.9 0.666667 1.3 1 2.34 1.2 6 2 30})
(mod "gametype:ammunition" {radiusFunction 0 0 0.566667 0.9 0.666667 1.3 1 2.34 1.2 6 2 30})
(mod "gametype:evacuation" {radiusFunction 0 0 0.566667 0.9 0.666667 1.3 1 2.34 1.2 6 2 30})
(mod "gametype:frontlines" {radiusFunction 0 0 0.566667 0.9 0.666667 1.3 1 2.34 1.2 6 2 30})
(mod "gametype:campaign_capture_the_flag" {radiusFunction 0 0 0.566667 0.9 0.666667 1.3 1 2.34 1.2 6 2 30})
	}

	{ZeroingAccuracy 0.7 0.6 0.5 0.4}

	{FiringTimeout 11 3}	; min delay between ai shots (note: will be affected by "grenade_timeout" modifier)
	{AccuracyByMotionK 0.1}

;	{crosshair ""}
;	{crosshairReloading ""}
	{SyncedProjectiles 1} 			;// visually syncs decal/crater spawn in multiplayer
	("recoil_rifle_bolt")
}
