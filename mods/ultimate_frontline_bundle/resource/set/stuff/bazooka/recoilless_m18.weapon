{from "pattern rpg_weapon"
	{tag "rocketlauncher_fx range_90"}
	{filling "ammo recoilless" 1}
	{entity "recoilless_m18"}
	{fireSound "reactive/d1/Shared/Recoilless_Rifle/"}
	{reloadsound "bazooka"}
	{calibre 57}
	{mass 20.1}

	("velocity" mps(370))

	("human health" damage(500))

	{parameters "he"			; M306 Rocket
		{cursorReloading "gun_he"}
		("armor health" damage(250))
	}

	{parameters "heat"			; M307 Rocket
		{cursorReloading "gun_heat"}
		{projectileDamageTable {95 80} {100 0}}
		("armor health" damage(250))
	}

	{parameters "wp"			; M308 Rocket
		{cursorReloading "gun_wp"}
	}
	{gravity 3.5} ;//same as other direct-fire "cannon" type weapons
	; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {range 90 90})))))
(mod "gametype:battle_zones" {range 135 135})
(mod "gametype:ammunition" {range 135 135})
(mod "gametype:evacuation" {range 135 135})
(mod "gametype:frontlines" {range 135 135})
(mod "gametype:campaign_capture_the_flag" {range 135 135})
	("standard_slope")

	{spreading 1.25} ;// improved accuracy due to sight
}
