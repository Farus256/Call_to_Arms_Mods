{from "pattern gun"			; L/48.4 "f22"
	{filling "bulletrus_76"}
	{fireSound "cannon/s3/d1/Shared/Cannon_75to76mm/"}
	{fireSoundclose "cannon/s3/3p/Shared/Cannon_75to76mm/"}
	{reloadSound "utility/"}
	("range_190")
	{calibre 76.2}
	("canister_shot_18")

	("reload time" seconds(5.6))

	("velocity m/s" ap(690) apcr(991) he(706) heat(1))
	("armor health" damage(200))
	("armor health custom" shell(aphebc) velocity(690) damage(200) filler(150))
	("armor health custom" shell(aphebc2) velocity(690) damage(200) filler(88))
	("76_rus_slope_multipliers")

	; BR-350A
	("penetration_medium" shell(aphebc) range(190) a(81) b(71) c(62) d(56) e(51))  ;RHA
