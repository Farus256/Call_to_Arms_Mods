(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {range 340 340})))))
(mod "gametype:battle_zones" {range 510 510})
(mod "gametype:ammunition" {range 510 510})
(mod "gametype:evacuation" {range 510 510})
(mod "gametype:frontlines" {range 510 510})
