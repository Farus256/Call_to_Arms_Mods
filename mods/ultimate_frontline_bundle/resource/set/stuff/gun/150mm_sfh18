;_________________________________________
; ARTY - German heavy howitzer
;=========================================


{from "pattern gun"			; L/30 "Hummel", "sfh18"
	{filling "bulletger_150_l30"}
	{fireSound "cannon/s5/d1/Shared/Cannon_150to210mm/"}
	{fireSoundClose "cannon/s5/3p/Shared/Cannon_150to210mm/"}
	{reloadSound "utility/"}
	("heavy_artillery")
	{calibre 150}
	; UFB realism: native non-story gametype conditions
{range 385 385}
(mod "gametype:battle_zones" {range 577.5 577.5})
(mod "gametype:ammunition" {range 577.5 577.5})
(mod "gametype:evacuation" {range 577.5 577.5})
(mod "gametype:frontlines" {range 577.5 577.5})
(mod "gametype:campaign_capture_the_flag" {range 577.5 577.5}) ; // 13.3km

	("reload time" seconds(30))

	("velocity m/s" ap(476) apcr(1) he(204) heat(460))
	("armor health" damage(450))
	("armor health custom" shell(apcbche) damage(450) velocity(476) filler(4075))
	("armor health custom" shell(apcbche2) damage(450) velocity(476) filler(3250))
	("85-155_slope_multipliers")

	; Gr.39 Hl/A
	("penetration_medium" shell(heat) range(190) a(184) b(184) c(184) d(184) e(184))

	; Gr.19 Be
	("penetration_medium" shell(apcbche) range(200) a(169) b(148) c(130) d(120) e(102))
	{parameters "apcbche" ("velocity" mps(476))}

	; Gr.19 Be rot
	("penetration_medium" shell(apcbche2) range(200) a(188) b(168) c(145) d(134) e(122)) 
	;// It seems like US conducted firing tests are against FHA armor, too much pen for this kind of shell. Reduced pen by 10% in comparison with tests
	{parameters "apcbche2" ("velocity" mps(476))}
	
	("accuracy_indirect"   ; // Applies logic for accuracy of indirect weapons over 200m
		r1(0.85) 				; // Accuracy radius for direct-fire munitions
		r2(8.25) 					; // Accuracy radius for indirect fire
		rmax(27) 				; // Accuracy radius for indirect fire at maximum range
		range_ap(200) 			; // Range after which accuracy drops to prevent farshooting.
		range_heat(190) 		; // Range after which accuracy drops to prevent farshooting.
		range_he(385)			; // Range after which accuracy drops to prevent farshooting.
	)
}
