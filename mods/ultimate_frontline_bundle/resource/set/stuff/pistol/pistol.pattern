{from "pattern bullet"
	{tag "weapon pistol bullet to_hand -shoot_walking -shoot_walking_ai shoot_walking_manual auto_eject"}
	{inventory
		{size 2 1}
		{weight 100}
		{fsm "pistol"}
	}

	{cursor "ironsights/smg"}

	; UFB realism: native non-story gametype conditions
{range 70 70}
(mod "gametype:battle_zones" {range 105 105})
(mod "gametype:ammunition" {range 105 105})
(mod "gametype:evacuation" {range 105 105})
(mod "gametype:frontlines" {range 105 105})
(mod "gametype:campaign_capture_the_flag" {range 105 105})

	{curve "bullet_pistol"}

	("reload time" seconds(3.25))
	("fire rate" rpm(300))

	{FiringTimeout 1.0 0.5}
	; UFB realism: native non-story gametype conditions
{FiringTimeoutDistanceFactor
		{0.3 0.5}	;21m, 0.5s
		{1.0 1.0}	;70m, 1.0s
	}
(mod "gametype:battle_zones" {FiringTimeoutDistanceFactor {0.2 0.5} {0.666667 1.0}})
(mod "gametype:ammunition" {FiringTimeoutDistanceFactor {0.2 0.5} {0.666667 1.0}})
(mod "gametype:evacuation" {FiringTimeoutDistanceFactor {0.2 0.5} {0.666667 1.0}})
(mod "gametype:frontlines" {FiringTimeoutDistanceFactor {0.2 0.5} {0.666667 1.0}})
(mod "gametype:campaign_capture_the_flag" {FiringTimeoutDistanceFactor {0.2 0.5} {0.666667 1.0}})

	{spreading
		{BurstAccuracy 100 95 90 85 80}
	}
	{SpreadTolerance 0.3}			;// AI needs to aim 30%
	
	("human health" damage(60))

	("penetration" args 3 0)
	("armor health" damage(1))

	("accuracy_pistol")
	("ap_slope_multiplier")

	{thirdpersonparams inherit "human default"}
	{SyncedProjectiles 1} 			;// visually syncs decal/crater spawn in multiplayer

	("recoil_pistol")
	("sway_pistol")
}
