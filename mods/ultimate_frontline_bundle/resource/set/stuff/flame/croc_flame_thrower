;_________________________________________
; British Tank Flamethrower
;=========================================

{from "pattern flame_thrower"	;// Churchill Crocodile Flamethrower
	{entity "croc_flame_thrower"}
	("filling_tank" fuel(20))	;// Fuel tank ~1,800 Liters. Would last ~80s of bursts
	{mass 150}

	{foresight "foresight4"}

	; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {range 80 80})))))
(mod "gametype:battle_zones" {range 96 96})
(mod "gametype:ammunition" {range 96 96})
(mod "gametype:evacuation" {range 96 96})
(mod "gametype:frontlines" {range 96 96})
(mod "gametype:campaign_capture_the_flag" {range 96 96})		;// irl 120-150yds
	{speed 45}
	{recoveryTime 0.05}	;// increase fuel consumption by 2x
	{rechargeTime 0.05}
	{burst {min 2}}
}