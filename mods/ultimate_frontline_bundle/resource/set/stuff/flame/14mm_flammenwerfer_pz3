{from "pattern flame_thrower"		; panzer3_flamm
	{tag "gun"}
	{entity "14mm_flammenwerfer_pz3"}

	("filling_tank" fuel(510))	;// Panzer3 had 2 Fuel tanks and could hold 1020 Liters. Other 520 liters is in vehicle inventory.
