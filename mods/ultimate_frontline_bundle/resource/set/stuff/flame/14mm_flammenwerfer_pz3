(mod "gametype:battle_zones" {range 72 72})
(mod "gametype:ammunition" {range 72 72})
(mod "gametype:evacuation" {range 72 72})
(mod "gametype:frontlines" {range 72 72})
(mod "gametype:campaign_capture_the_flag" {range 72 72})	;// irl range 50-60m
	{speed 40}

	{rechargeTime 2}
}