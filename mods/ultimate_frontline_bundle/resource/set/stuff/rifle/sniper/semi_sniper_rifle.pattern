{from "pattern rifle"
	{tag "sniper -shoot_walking -shoot_walking_ai shoot_walking_manual auto_eject rifle_shell"}

	{special
		{mode aim}
		{PrepareTime 1.5}
		{PrepareCursor "aimed_shot"}
		{PrepareCursorScene "aimed_shot_scene"}
		{accuracy 1.5}
		{damage 2.25}
	}

	{cursor "ironsights/mg"}

	{curve "bullet_sniper"}
	; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {range 120 120})))))
(mod "gametype:battle_zones" {range 180 180})
(mod "gametype:ammunition" {range 180 180})
(mod "gametype:evacuation" {range 180 180})
(mod "gametype:frontlines" {range 180 180})
(mod "gametype:campaign_capture_the_flag" {range 180 180})

	{spreading
		{BurstAccuracy 100 90 80 70 60 50}
	}

	{aimingTolerance 2.5}
	{RelaxationTime 1.5}
	("fire rate" rpm(175))

	("human health" damage(70))
	("penetration" args 6.5 3.5)
	{FiringTimeout 2.5 0.5}
	; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {FiringTimeoutDistanceFactor
		{0.2 0.55}	;24m, 1.1s
		{0.4 0.75}	;48m, 1.5s
		{0.8 1.0}	;96m, 2.0s
	})))))
(mod "gametype:battle_zones" {FiringTimeoutDistanceFactor {0.133333 0.55} {0.266667 0.75} {0.533333 1.0}})
(mod "gametype:ammunition" {FiringTimeoutDistanceFactor {0.133333 0.55} {0.266667 0.75} {0.533333 1.0}})
(mod "gametype:evacuation" {FiringTimeoutDistanceFactor {0.133333 0.55} {0.266667 0.75} {0.533333 1.0}})
(mod "gametype:frontlines" {FiringTimeoutDistanceFactor {0.133333 0.55} {0.266667 0.75} {0.533333 1.0}})
(mod "gametype:campaign_capture_the_flag" {FiringTimeoutDistanceFactor {0.133333 0.55} {0.266667 0.75} {0.533333 1.0}})

	("accuracy_rifle_auto_sniper")

	{thirdpersonparams inherit "human default"}

	("recoil_sniper_semi")
	("sway_sniper")
	("ap_7_62_slope_multiplier")
}