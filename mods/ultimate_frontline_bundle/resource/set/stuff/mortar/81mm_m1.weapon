;_________________________________________
; US Medium Mortar - 81mm
;=========================================


{from "pattern mortar"
	{filling "mortarusa_81"}
	{fireSound "cannon/s2/d1/Shared/Mortar/"}
	{fireSoundClose "cannon/s2/d1/Shared/Mortar/"}
	{calibre 81}
	("medium_mortar_range")
	{parameters "he2 heavy"
		; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {aimRange 140})))))
(mod "gametype:battle_zones" {aimRange 210})
(mod "gametype:ammunition" {aimRange 210})
(mod "gametype:evacuation" {aimRange 210})
(mod "gametype:frontlines" {aimRange 210})
(mod "gametype:campaign_capture_the_flag" {aimRange 210})
		; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {maxRange 140})))))
(mod "gametype:battle_zones" {maxRange 210})
(mod "gametype:ammunition" {maxRange 210})
(mod "gametype:evacuation" {maxRange 210})
(mod "gametype:frontlines" {maxRange 210})
(mod "gametype:campaign_capture_the_flag" {maxRange 210})
	}
}