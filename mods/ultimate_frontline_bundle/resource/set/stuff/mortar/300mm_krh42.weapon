;_________________________________________
; Finnish Super-Heavy Mortar - 300mm
;=========================================


{from "pattern mortar"
	{filling "mortarfin_300"}
	{fireSound "cannon/s4/d1/Shared/Cannon_105to130mm_LV/"}
	{fireSoundClose "cannon/s4/3p/Shared/Cannon_105to130mm_LV/"}
	{calibre 300}

	{spreading
		; UFB realism: native non-story gametype conditions
{radiusTable {0 9} {125 9} {250 19} {299.99 27} {300 100}}
(mod "gametype:battle_zones" {radiusTable {0 9} {125 9} {250 19} {299.99 27} {450 48.6} {450.01 100}})
(mod "gametype:ammunition" {radiusTable {0 9} {125 9} {250 19} {299.99 27} {450 48.6} {450.01 100}})
(mod "gametype:evacuation" {radiusTable {0 9} {125 9} {250 19} {299.99 27} {450 48.6} {450.01 100}})
(mod "gametype:frontlines" {radiusTable {0 9} {125 9} {250 19} {299.99 27} {450 48.6} {450.01 100}})
(mod "gametype:campaign_capture_the_flag" {radiusTable {0 9} {125 9} {250 19} {299.99 27} {450 48.6} {450.01 100}})
	}

	; UFB realism: native non-story gametype conditions
{aimRange 300}
(mod "gametype:battle_zones" {aimRange 450})
(mod "gametype:ammunition" {aimRange 450})
(mod "gametype:evacuation" {aimRange 450})
(mod "gametype:frontlines" {aimRange 450})
(mod "gametype:campaign_capture_the_flag" {aimRange 450})
	{minRange 50}
	; UFB realism: native non-story gametype conditions
{maxRange 300}
(mod "gametype:battle_zones" {maxRange 450})
(mod "gametype:ammunition" {maxRange 450})
(mod "gametype:evacuation" {maxRange 450})
(mod "gametype:frontlines" {maxRange 450})
(mod "gametype:campaign_capture_the_flag" {maxRange 450})
	("reload time" seconds(60))

	{parameters "he"
		{projectileDamageTable {0 50}}
	}
}