;_________________________________________
; German Medium Mortar - 9cm 
;=========================================


{from "pattern mortar"
	{filling "mortarger_92"}
	{fireSound "cannon/s1/d1/Shared/Mortar/"}
	{fireSoundClose "cannon/s1/d1/Shared/Mortar/"}
	{calibre 92}
	{spreading 
		; UFB realism: native non-story gametype conditions
{radiusTable {0 0.8} {20 1.5} {40 25} {140 100}}
(mod "gametype:battle_zones" {radiusTable {0 0.8} {20 1.5} {60 2.7} {60.01 25} {160.01 100}})
(mod "gametype:ammunition" {radiusTable {0 0.8} {20 1.5} {60 2.7} {60.01 25} {160.01 100}})
(mod "gametype:evacuation" {radiusTable {0 0.8} {20 1.5} {60 2.7} {60.01 25} {160.01 100}})
(mod "gametype:frontlines" {radiusTable {0 0.8} {20 1.5} {60 2.7} {60.01 25} {160.01 100}})
(mod "gametype:campaign_capture_the_flag" {radiusTable {0 0.8} {20 1.5} {60 2.7} {60.01 25} {160.01 100}})
	}

	; UFB realism: native non-story gametype conditions
{aimRange 22}
(mod "gametype:battle_zones" {aimRange 33})
(mod "gametype:ammunition" {aimRange 33})
(mod "gametype:evacuation" {aimRange 33})
(mod "gametype:frontlines" {aimRange 33})
(mod "gametype:campaign_capture_the_flag" {aimRange 33})
	{minRange 7}
	; UFB realism: native non-story gametype conditions
{maxRange 22}
(mod "gametype:battle_zones" {maxRange 33})
(mod "gametype:ammunition" {maxRange 33})
(mod "gametype:evacuation" {maxRange 33})
(mod "gametype:frontlines" {maxRange 33})
(mod "gametype:campaign_capture_the_flag" {maxRange 33})
	("reload time" seconds(5.5))

	{parameters "he"
		{projectileDamageTable {0 10}}
	}
	{parameters "sm"
		("reload time" seconds(4.0))
	}
}