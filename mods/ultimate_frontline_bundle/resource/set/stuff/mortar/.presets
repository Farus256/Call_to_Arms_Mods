
(include "\set\blast.inc")

(define "reload time"			;//reload time for magazine or shell
	{rechargeTime %seconds}
)

(define "fire rate"				;// rate of fire in rounds per minute 
	{recoveryTime (/ 60 %rpm)}
)

;/*--------------------------------------RANGES AND ACCURACY--------------------------------------*/


(define "light_mortar_range"
	{spreading 
		; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {radiusTable {0 4.5} {120 16.2} {139.99 22.5} {140 70}})))))
(mod "gametype:battle_zones" {radiusTable {0 4.5} {120 16.2} {139.99 22.5} {210 40.5} {210.01 70}})
(mod "gametype:ammunition" {radiusTable {0 4.5} {120 16.2} {139.99 22.5} {210 40.5} {210.01 70}})
(mod "gametype:evacuation" {radiusTable {0 4.5} {120 16.2} {139.99 22.5} {210 40.5} {210.01 70}})
(mod "gametype:frontlines" {radiusTable {0 4.5} {120 16.2} {139.99 22.5} {210 40.5} {210.01 70}})
(mod "gametype:campaign_capture_the_flag" {radiusTable {0 4.5} {120 16.2} {139.99 22.5} {210 40.5} {210.01 70}})
	}

	; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {aimRange 140})))))
(mod "gametype:battle_zones" {aimRange 210})
(mod "gametype:ammunition" {aimRange 210})
(mod "gametype:evacuation" {aimRange 210})
(mod "gametype:frontlines" {aimRange 210})
(mod "gametype:campaign_capture_the_flag" {aimRange 210})
	{minRange 30}
	; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {maxRange 140})))))
(mod "gametype:battle_zones" {maxRange 210})
(mod "gametype:ammunition" {maxRange 210})
(mod "gametype:evacuation" {maxRange 210})
(mod "gametype:frontlines" {maxRange 210})
(mod "gametype:campaign_capture_the_flag" {maxRange 210})
	("reload time" seconds(4.5))

	{parameters "he"
		{projectileDamageTable {0 10}}
	}
	{parameters "he2"
		{projectileDamageTable {0 10}}
	}
	{parameters "sm"
		("reload time" seconds(3.0))
	}
	{parameters "wp"
		("reload time" seconds(3.0))
	}
)

