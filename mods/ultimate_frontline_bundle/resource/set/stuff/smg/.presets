(define "burst_short_slow"
	{burst
		{short 4 1}
		{long 6 2}
		; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {rangeKoef 0.4})))))
(mod "gametype:battle_zones" {rangeKoef 0.266667})
(mod "gametype:ammunition" {rangeKoef 0.266667})
(mod "gametype:evacuation" {rangeKoef 0.266667})
(mod "gametype:frontlines" {rangeKoef 0.266667})
(mod "gametype:campaign_capture_the_flag" {rangeKoef 0.266667})
	}
	; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {FiringTimeoutDistanceFactor
		{0.25 0.25}	;20m, 0.5s
		{0.7 0.5}	;56m, 1.0s
		{1.0 0.5}	;80m, 1.0s
	})))))
(mod "gametype:battle_zones" {FiringTimeoutDistanceFactor {0.166667 0.25} {0.466667 0.5} {0.666667 0.5}})
(mod "gametype:ammunition" {FiringTimeoutDistanceFactor {0.166667 0.25} {0.466667 0.5} {0.666667 0.5}})
(mod "gametype:evacuation" {FiringTimeoutDistanceFactor {0.166667 0.25} {0.466667 0.5} {0.666667 0.5}})
(mod "gametype:frontlines" {FiringTimeoutDistanceFactor {0.166667 0.25} {0.466667 0.5} {0.666667 0.5}})
(mod "gametype:campaign_capture_the_flag" {FiringTimeoutDistanceFactor {0.166667 0.25} {0.466667 0.5} {0.666667 0.5}})
)

