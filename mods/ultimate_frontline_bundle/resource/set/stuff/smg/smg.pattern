{from "pattern bullet"
	{tag "smg smg_shell weapon bullet to_hand auto_eject shoot_walking_manual -shoot_walking"}
	{inventory
		{size 5 2}
		{link_bone "gun_back"}
		{weight 100}
	}

	{cursor "ironsights/smg"}

	; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {range 80 80})))))
(mod "gametype:battle_zones" {range 120 120})
(mod "gametype:ammunition" {range 120 120})
(mod "gametype:evacuation" {range 120 120})
(mod "gametype:frontlines" {range 120 120})
(mod "gametype:campaign_capture_the_flag" {range 120 120})

	{curve "bullet_smg"}

	{LockFireDistanceTime 0.5}
	{foresight "Foresight11"}
	{SpreadTolerance 0.3}			;// AI needs to aim 30%
	{aimingTolerance 2}
	{traceFreq 3}
	{Automatic}

	("reload time" seconds(5))

	{spreading
		{BurstAccuracy 100 95 90 85 80 75 70 65 60}
		{SpreadXYRatio	1.5}
	}
	{FiringTimeout 2.0 0.5}

	("human health" damage(55))
	("penetration" args 4)
	("armor health" damage(2))

	("accuracy_smg")
	("ap_slope_multiplier")

	{thirdpersonparams inherit "human default"}
	("recoil_smg_medium")
	("sway_smg")
	{AccuracyByMotionK 0.9}
}