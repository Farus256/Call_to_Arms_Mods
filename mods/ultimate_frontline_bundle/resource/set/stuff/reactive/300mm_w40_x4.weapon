;_________________________________________
; German Heavy Rocket Artillery
;=========================================


{from "pattern reactive"		; "pz38h_w40"
	{filling "ammo 300mm_nebelwerfer" 4}
	{fireSound "reactive/nebel_burst/"}
	{calibre 300}

	("rocket_artillery")

	{spreading
		; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {radiusTable
			{0 0}
			{100 10}
			{200 20}
			{279.99 30} ;// max range
			{280 100}
			{310 200}
		})))))
(mod "gametype:battle_zones" {radiusTable {0 0} {100 10} {200 20} {279.99 30} {420 54} {420.01 100} {450.01 200}})
(mod "gametype:ammunition" {radiusTable {0 0} {100 10} {200 20} {279.99 30} {420 54} {420.01 100} {450.01 200}})
(mod "gametype:evacuation" {radiusTable {0 0} {100 10} {200 20} {279.99 30} {420 54} {420.01 100} {450.01 200}})
(mod "gametype:frontlines" {radiusTable {0 0} {100 10} {200 20} {279.99 30} {420 54} {420.01 100} {450.01 200}})
(mod "gametype:campaign_capture_the_flag" {radiusTable {0 0} {100 10} {200 20} {279.99 30} {420 54} {420.01 100} {450.01 200}})
	}

	{burst 
		{min 4}
		{noaiming}
	}
	{gravity 2}

	{minRange 50}
	; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {maxRange 280})))))
(mod "gametype:battle_zones" {maxRange 420})
(mod "gametype:ammunition" {maxRange 420})
(mod "gametype:evacuation" {maxRange 420})
(mod "gametype:frontlines" {maxRange 420})
(mod "gametype:campaign_capture_the_flag" {maxRange 420}) ;//4,55km
	("velocity" mps(230))
	("reload time" seconds(220))
	("fire rate" rpm(36)) ;// 6.6s to fire full salvo
}