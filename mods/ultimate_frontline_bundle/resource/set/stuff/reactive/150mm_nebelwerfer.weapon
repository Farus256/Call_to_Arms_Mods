;_________________________________________
; German Light Rocket Artillery
;=========================================


{from "pattern reactive"		; "150mm_nebelwerfer41"
	{tag "gun"}
	{filling "ammo 150mm_nebelwerfer" 6}
	{fireSound "reactive/nebel_burst/"}
	{calibre 150}

	("rocket_artillery")

	{spreading
		; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {radiusTable
			{0 0}
			{100 8}
			{200 18}
			{309.99 20} ;// max range
			{310 100}
			{350 200}
		})))))
(mod "gametype:battle_zones" {radiusTable {0 0} {100 8} {200 18} {309.99 20} {465 36} {465.01 100} {505.01 200}})
(mod "gametype:ammunition" {radiusTable {0 0} {100 8} {200 18} {309.99 20} {465 36} {465.01 100} {505.01 200}})
(mod "gametype:evacuation" {radiusTable {0 0} {100 8} {200 18} {309.99 20} {465 36} {465.01 100} {505.01 200}})
(mod "gametype:frontlines" {radiusTable {0 0} {100 8} {200 18} {309.99 20} {465 36} {465.01 100} {505.01 200}})
(mod "gametype:campaign_capture_the_flag" {radiusTable {0 0} {100 8} {200 18} {309.99 20} {465 36} {465.01 100} {505.01 200}})
	}

	{burst
		{min 6}
		{noaiming}
	}

	{parameters "sm"
		("reload time" seconds(60.0))
		("fire rate" rpm(44.4))
		("velocity" mps(300))
		{minRange 50}
		; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {aimRange 340})))))
(mod "gametype:battle_zones" {aimRange 510})
(mod "gametype:ammunition" {aimRange 510})
(mod "gametype:evacuation" {aimRange 510})
(mod "gametype:frontlines" {aimRange 510})
(mod "gametype:campaign_capture_the_flag" {aimRange 510})
		; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {maxRange 340})))))
(mod "gametype:battle_zones" {maxRange 510})
(mod "gametype:ammunition" {maxRange 510})
(mod "gametype:evacuation" {maxRange 510})
(mod "gametype:frontlines" {maxRange 510})
(mod "gametype:campaign_capture_the_flag" {maxRange 510}) ;//7,8km
		
		{cursorReloading "gun_sm"}

		{spreading
			; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {radiusTable
				{0 0}
				{100 7}
				{200 18}
				{310 20}
				{339.99 22}
				{340 100}
				{390 200}
			})))))
(mod "gametype:battle_zones" {radiusTable {0 0} {100 7} {200 18} {310 20} {339.99 22} {510 39.6} {510.01 100} {560.01 200}})
(mod "gametype:ammunition" {radiusTable {0 0} {100 7} {200 18} {310 20} {339.99 22} {510 39.6} {510.01 100} {560.01 200}})
(mod "gametype:evacuation" {radiusTable {0 0} {100 7} {200 18} {310 20} {339.99 22} {510 39.6} {510.01 100} {560.01 200}})
(mod "gametype:frontlines" {radiusTable {0 0} {100 7} {200 18} {310 20} {339.99 22} {510 39.6} {510.01 100} {560.01 200}})
(mod "gametype:campaign_capture_the_flag" {radiusTable {0 0} {100 7} {200 18} {310 20} {339.99 22} {510 39.6} {510.01 100} {560.01 200}})
		}
	}
	{parameters "he"
		{minRange 50}
		; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {aimRange 310})))))
(mod "gametype:battle_zones" {aimRange 465})
(mod "gametype:ammunition" {aimRange 465})
(mod "gametype:evacuation" {aimRange 465})
(mod "gametype:frontlines" {aimRange 465})
(mod "gametype:campaign_capture_the_flag" {aimRange 465})
		; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {maxRange 310})))))
(mod "gametype:battle_zones" {maxRange 465})
(mod "gametype:ammunition" {maxRange 465})
(mod "gametype:evacuation" {maxRange 465})
(mod "gametype:frontlines" {maxRange 465})
(mod "gametype:campaign_capture_the_flag" {maxRange 465}) ;//6,9km
	}

	("velocity" mps(340))
	("reload time" seconds(120))
	("fire rate" rpm(36)) ;// 10s to fire full salvo
}