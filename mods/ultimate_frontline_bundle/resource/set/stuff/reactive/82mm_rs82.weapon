;_________________________________________
; Soviet Light Aerial Rocket Launcher
;=========================================


{from "pattern reactive"		; "IL-2"
	{tag "-gun"}
	{filling "ammo 82mm_rs82" 8}
	{fillingVisible "rocket"}
	{fireSound "reactive/rocket_burst/"}
	{inventory {noView}}
	{calibre 82}

	{spreading
		{SpreadRadius 4}
		{SpreadXYRatio 5}
		{SpreadYadjust 0.1}
		{radiusFunction
			1		0.1
			300		1
			400		2
		}
	}

	{Automatic}
	{burst
		{min 8}
		{noaiming}
	}

	; UFB realism: native non-story gametype conditions
(mod not "gametype:battle_zones" (mod not "gametype:ammunition" (mod not "gametype:evacuation" (mod not "gametype:frontlines" (mod not "gametype:campaign_capture_the_flag" {range 1 300})))))
(mod "gametype:battle_zones" {range 1.5 450})
(mod "gametype:ammunition" {range 1.5 450})
(mod "gametype:evacuation" {range 1.5 450})
(mod "gametype:frontlines" {range 1.5 450})
(mod "gametype:campaign_capture_the_flag" {range 1.5 450})
	("fire rate" rpm(240))
	("reload time" seconds(40))
	("velocity" mps(340))
	("aerial gravity")
}