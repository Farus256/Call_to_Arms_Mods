; Purpose of ammo.set
; Select the best weapon or ammo to use against each target class. When units have multiple weapons/ammo that can 
; be used against a specific target, the order of this list (from top to bottom) tells unit which item to use first. 
; If the target is not in range of the first weapon/ammo type, the unit skips to the next listed item until it finds
; a weapon/ammo type in its inventory that has enough range to attack the target. 


; Defining Terms
; {ready_for_shot} 			- ammo used only when charged (shell loaded, ready for shot or for humans, item is in hand) 
; {charging} 				- when a gun is reloading, only then can it switch to / use this ammo type
; {enable_for_human_user 0} - the 0 disables use of weapon/ammo for units while actively controlled/selected by player
; {enable_for_ai 0} 		- the 0 disables use of weapon/ammo for units under AI control
; {enable_for_user 0} 		- prohibit the usage for player controlled units, even when the player does not have them actively selected
; {check_grenade} 			- prohibit self-damaging and only use ammo if target is protected by cover
; {ground} 					- shot will be aimed at ground underneath the enemy instead of directly at the enemy. only computed on target re-assignment
; {volume "engine"} 		- shot will be aimed at volume listed inside the "" until or unless that volume is broken
; {disable}					- prohibit usage and reject ammo entirely for further checks


{select_ammo
	{human in_bush											; -TARGET CLASS-
		; UFB: respect a player launcher already prepared in hand.
		{"panzerfaust" {enable_for_ai 0} {ready_for_shot}}
		{"ammo rocketlauncher" {enable_for_ai 0} {ready_for_shot}}
		{"sharp_edge"}										; thrown knives
		
		{"flame" {ready_for_shot}}							; ammo for flamethrowers
		
		{"grenade fg" {check_grenade}}						; standard anti-personel grenades
		{"grenade fg" {ground} {check_grenade}}				; standard anti-personel grenades
		{"ammo rifle_grenade"}								; rifle grenade HE ammo
									; rifle grenade HEAT ammo
		
		{"hmgun"}											; heavy machine gun (.50 cal, etc)		
		{"mgun mgun_belt"}									; prioritise using belt-fed MG's over mag-fed MG's		
		{"mgun"}											; prioritise using MG's over rifles
		{"assaultrifle"}									; prioritise using assault rifles over rifles
		{"battlerifle"}										; prioritise using battle rifles over rifles
		{"smg smg_drum"}									; prioritise using drum-fed SMG's over mag-fed SMG's
		{"smg"}												; prioritise using SMG's over rifles

		{"panzerfaust" {ground} {check_grenade} {enable_for_user 0} {ready_for_shot}}	; bazooka class ammo
		{"ammo rocketlauncher" {ground} {check_grenade} {enable_for_user 0} {ready_for_shot}}	; bazooka class ammo
		
		{"semi_rifle"}										; prioritise using semi auto rifles over rifles
		{"rifle"}											; prioritise using rifles over pistols
		{"pistol"{ready_for_shot}}							; prioritise using pistols over revolvers
		{"revolver"{ready_for_shot}}						; revolver ammo
		{"small_arms"{ready_for_shot}}						; bullet ammo (pistols, rifles, smgs, mgs)
		{"bullet"{ready_for_shot}}							; bullet ammo (pistols, rifles, smgs, mgs)
		{"pistol"}							; UFB: draw a sidearm when the main weapon is dry
		{"revolver"}						; UFB: draw a sidearm when the main weapon is dry
		{"ptr"{ready_for_shot}}
		{"ammo rifle_grenade_at" {check_grenade}}								; anti-tank rifle ammo

		{"grenade at" {ground} {check_grenade} {enable_for_user 0} {ready_for_shot}}			; anti-tank grenades
		{"dynamite"{ground} {check_grenade} {enable_for_user 0} {ready_for_shot}}				; explosive charges	
	
		{"mortar all_he"}									; HE mortar ammo
		{"mortar ic"{enable_for_user 0}}					; IC mortar ammo
		{"mortar ic"{ready_for_shot}}						; IC mortar ammo
		
		{"shell all_he" {ground} {enable_for_human_user 0}}	; cannon HE ammo	
		{"sr shrapnel" {ground}{ready_for_shot}}			; cannon SR ammo	
		{"shell ic"{ground}{enable_for_user 0}}				; flame shell
		{"ammo shell wp" {ground}{enable_for_human_user 0}}	; WP ammo
		{"sr shrapnel artillery" {ground}{ready_for_shot}}	; arty SR ammo	
		{"sr shrapnel arty" {ground}{ready_for_shot}}		; arty SR ammo	
		{"all_he auto"}										; auto cannon HE ammo
		{"can canister" {disable}}							; cannon CAN ammo
		
		{"grenade thermite"}								; flame grenades (thermite)
		{"grenade ic"}										; flame grenades (molotov)
		{"glass ic"}										; flame shell (Ampulomet glass ball)
		
		{"shell heat_high" {ground} {enable_for_user 0}}	; cannon HEAT ammo (penetration > 150mm)
		{"shell heat_medium" {ground} {enable_for_user 0}}	; cannon HEAT ammo (penetration 100-150mm)
		{"shell heat_low" {ground} {enable_for_user 0}}		; cannon HEAT ammo (penetration < 100mm)

		{"rc_bomb"{disable}}								; borgwards/goliaths

		{"rocketselector" {enable_for_user 0}}				; rocket artillery
		{"zenite"}											; autocannon AP/APCR ammo
		{"light"}											; ammo for binoculars and other vision devices
		
		{"flare mrls"{disable}}								; ammo for flareguns		
		{"flare_usa"{disable}}								; ammo for flareguns
		{"flare"{disable}}									; ammo for flareguns
		{"sword bullet"{disable}}							; swords
	}
