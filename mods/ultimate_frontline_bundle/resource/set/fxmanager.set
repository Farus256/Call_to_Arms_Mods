;=============================================================================
; MERGED fxmanager.set
; Uses Persistent Everything's maximum limits for all FX groups
; Bundle: Ultimate Frontline Bundle (No PBR)
;=============================================================================
{fxmanager
	{group
;		{fx "shellhole_big"}
;		{fx "shellhole_medium"}
;		{fx "shellhole_small"}
;		{fx "fire_shellhole"}
		{countLimit 9999}
	}
	{group
		{fx "tracks_big"}
		{fx "tracks_mid"}
		{fx "tracks_sm"}
		{fx "tracks_sm2"}
		{fx "tracewheel01"}
		{fx "tracewheel01a"}
		{fx "tracewheel01d"}
		{fx "tracewheel02"}
		{fx "tracewheel02a"}
		{fx "tracewheel02d"}
		{fx "tracewheel03"}
		{fx "tracewheel03a"}
		{fx "tracewheel03d"}
		{fx "tracewheel04"}
		{fx "tracewheel04d"}
		{fx "tracewheel05"}
		{fx "tracewheel05a"}
		{fx "tracewheel05d"}
		{fx "tracewheel06"}
		{fx "traceski01"}
		; UFB realism: native non-story gametype conditions
{countLimit 9999}
(mod "gametype:battle_zones" {countLimit 3000})
(mod "gametype:ammunition" {countLimit 3000})
(mod "gametype:evacuation" {countLimit 3000})
(mod "gametype:frontlines" {countLimit 3000})
(mod "gametype:campaign_capture_the_flag" {countLimit 3000})
		; UFB realism: native non-story gametype conditions
{timeLimit 9999}
(mod "gametype:battle_zones" {timeLimit 1800})
(mod "gametype:ammunition" {timeLimit 1800})
(mod "gametype:evacuation" {timeLimit 1800})
(mod "gametype:frontlines" {timeLimit 1800})
(mod "gametype:campaign_capture_the_flag" {timeLimit 1800})			; seconds
	}
	{group
		{fx "flashred"}
		{fx "flashgreen"}
		{fx "flashblue"}
		{fx "flashcover"}
		{fx "flashattack"}
		{fx "flashattackat"}
		{fx "flashsmoke"}
		{timeLimit 0.05}
	}
}
