; Profiles for various weapon classes. Defines how the damage to human health is adjusted over distance.
; 1st value is distance (weapon range multiplied by value)(example: weapon range 100m & value 0.5 = 50m)
; 2nd value is damage (weapon damage multiplied by value)(example: weapon damage 50 & value 0.5 = -25 health)
;	{curve "example"
;		{0.75	0.5}		at 75% of weapons max range, it does 50% of defined damage from weapon file

{ballistics
	; UFB realism: native non-story gametype conditions
{curve "bullet"			;// bolt action 70 dmg 120 range
		{0.05	3.00}		;// 0-12m  	 210d
		{0.1	2.00}		;// 12-24m   140d
		{0.2	1.35}		;// 24-36m   95d
		{0.3	1.00}		;// 36-80m   70d
		{0.65	0.80}		;// 80-120m  56d
		{1.0	0.40}		;// 120-132m 28d
		{1.1	0.10}		;// 132+ 	 7d
	}
(mod "gametype:battle_zones" {curve "bullet" {0.033333 3.00} {0.066667 2.00} {0.133333 1.35} {0.2 1.00} {0.433333 0.80} {0.666667 0.40} {1 0.26} {1.1 0.1}})
(mod "gametype:ammunition" {curve "bullet" {0.033333 3.00} {0.066667 2.00} {0.133333 1.35} {0.2 1.00} {0.433333 0.80} {0.666667 0.40} {1 0.26} {1.1 0.1}})
(mod "gametype:evacuation" {curve "bullet" {0.033333 3.00} {0.066667 2.00} {0.133333 1.35} {0.2 1.00} {0.433333 0.80} {0.666667 0.40} {1 0.26} {1.1 0.1}})
(mod "gametype:frontlines" {curve "bullet" {0.033333 3.00} {0.066667 2.00} {0.133333 1.35} {0.2 1.00} {0.433333 0.80} {0.666667 0.40} {1 0.26} {1.1 0.1}})
(mod "gametype:campaign_capture_the_flag" {curve "bullet" {0.033333 3.00} {0.066667 2.00} {0.133333 1.35} {0.2 1.00} {0.433333 0.80} {0.666667 0.40} {1 0.26} {1.1 0.1}})

