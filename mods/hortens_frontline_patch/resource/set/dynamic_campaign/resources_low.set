{Low
	{GlobalMaxCP 650}
	{StageCP 60 60 80 100 120}
	{SpecialCP 50}					;// airstrikes special tab
	{EmplacementCP 50}				;// buildable with engineer
	{Bots
		{StartMP	1.00 min 99999 attackerMultiplier 1.00}
		{FinishMP	1.00 min 99999 attackerMultiplier 1.00}
		{CP
			{Base "0:500"} ;// seconds : CP
			{RoundMultiplier "0:100"} ;// games played : multiplier for CP
			{AttackMultiplier 1}
		}
		{DefenseLevel
			{level_1
				{DefenseBudgetPlayer	0.15}	;// budget it multiplied by number of flags
				{DefenseBudgetAI		0.001}	;// places defender units with bot StartMP * this factor (StartMP without attackermultiplier) for player side
				{unlock games 0 progress 0.0}	;// number of games to unlock this level, or progress in percent (campaign progress bar)
			}
			{level_2							;// once level is reached previous level values are ignored only currently level is used
				{DefenseBudgetPlayer	0.25}
				{DefenseBudgetAI		0.001}
				{unlock games 1 progress 0.1}
			}
			{level_3
				{DefenseBudgetPlayer	0.35}
				{DefenseBudgetAI		0.001}
				{unlock games 6 progress 0.25}
			}
		}
	}
	;// {factor MP / SP / AP / RP} Assumes value of 1 if not defined. 
	{PaybackFactor 0.2 0 0 0}		;// MP paid back when loosing solider, squad or vehicle
	{SellFactor 0.5 0 0 0}
	{ScavengedVehicleSellFactor 0.2 0 0 0}		;// captured enemy vehicle 
	{RiskFactor
		{Low
			{BotResources 1.0}
			{BotVeterancy 1}
			{Rewards 1.00}
		}
		{Standard
			{BotResources 1.0}
			{BotVeterancy 1}
			{Rewards 1.25}
		}
		{High
			{BotResources 1.0}
			{BotVeterancy 1}
			{Rewards 1.5}
		}
	}
	{Resources
		{MP ;// Manpower (generic money)
			{StartVal 1500}
			{WinGain "1:200 2:225 4:250 6:325 8:325 9:325 10:350 12:375 16:400"} ;// games played : MP gain 
			{LoseGain "1:200 2:225 4:250 6:275 8:275 10:275 12:275"}
			{MapRewards	;//Bonus resources on various game types (a game can only be one randomly chosen type). Types: Airfield, Ammodepot, Bonus, Factory, Research.
				{Airfield	125}
				{Ammodepot	350}
				{Bonus		175}
				{Factory	650}
				{Research	125}
			}
		}
		{SP ;// Special Points (airstrikes)
			{StartVal 1}
			{WinGain 0}
			{LoseGain 0}
			{MapRewards
				{Airfield 4}
				{Bonus	  2}
			}
		}
		{AP ;// Ammo points
			{StartVal 1000}
			{WinGain "1:300 2:325 4:400 6:600 8:900 9:1000 10:1100 12:1100 14:1200"}
			{LoseGain "1:500"}
			{MapRewards
				{Airfield	200}
				{Ammodepot	900}
				{Bonus		100}
				{Factory	500}
				{Research	100}
			}
		}
		{RP ;// Research points
			{StartVal 6}
			{WinGain "1:2 8:4 9:2 16:4 17:2"}
			{LoseGain "1:2 8:4 9:2 16:4 17:2"}
			{MapRewards
				{Airfield	2}
				{Ammodepot	1}
				{Bonus		2}
				{Factory	1}
				{Research	3}
			}	
		}
		{Budget
			{Start "0:650"} ;// games played : starting CP of each match 
			{PointsPerSecond 50.0} ;// CP income
			{Limit 650} ;// Max CP 
		}
	}
	{ResupplyCost
		{Human
			{NewItem 0.5 AP}
			{Weight 0.5 AP}
			{Mechanic 0.5 AP}
		}
		{Vehicles
			{Weight 0.25 AP}
			{Fuel 1.5 AP}
			{Resupply 0.25 AP}
			{BrokenComponent
				{body 35 % MP 1 % AP}
				{turret 25 % MP 1 % AP}
				{engine 25 % MP 1 % AP}
				{track 15 % MP 1 % AP}
				{shield 1 % MP 1 % AP}
				{other 1 % MP 1 % AP} ;// If none of the above. Required.
			}
		}
		{Support
			{Airstrikes 100 % SP}
		}
	}
}