;=============================================================================
; MERGED entitymanager.set
; Combines Horten's Frontline groups, BM Mod's gore limbs group and Persistent Everything's 9999 limits
; Bundle: Ultimate Frontline Bundle (No PBR)
;=============================================================================
{entitymanager
	{group "dead" actor dead
		{limit 9999}
(mod "gametype:battle_zones" {limit 4096})
(mod "gametype:ammunition" {limit 4096})
(mod "gametype:evacuation" {limit 4096})
(mod "gametype:frontlines" {limit 4096})
(mod "gametype:campaign_capture_the_flag" {limit 4096})
		; UFB: identical mp/not-mp defaults consolidated above.
		{remove dissolve}
		{entity "human"}
	}

	; Horten's Frontline canister shot pellets (projectile leftovers, not persistence)
	{group "canister" gameentity
		(mod "mp" 		{limit 500})
		(mod not "mp"	{limit 500})
		{remove instant}
		{entity "canist_drob_d"}
		{entity "canister_shot_18"}
		{tag "canister_shell"}
	}
	; BM Mod limbs group - gore body parts
	{group "limbs" gameentity
		{limit 9999}
(mod "gametype:battle_zones" {limit 1024})
(mod "gametype:ammunition" {limit 1024})
(mod "gametype:evacuation" {limit 1024})
(mod "gametype:frontlines" {limit 1024})
(mod "gametype:campaign_capture_the_flag" {limit 1024})
		; UFB: identical mp/not-mp defaults consolidated above.
		{remove dissolve}
		{entity "human_part"}
		{entity "flesh"}
		{entity "bm_limb_a"}
		{entity "bm_limb_b"}
		{entity "bm_limb_c"}
		{tag "human_part"}
		{tag "flesh"}
		{tag "bm_limb_a"}
		{tag "bm_limb_b"}
		{tag "bm_limb_c"}
	}

	{group "broken" gameentity
		{limit 9999}
(mod "gametype:battle_zones" {limit 4096})
(mod "gametype:ammunition" {limit 4096})
(mod "gametype:evacuation" {limit 4096})
(mod "gametype:frontlines" {limit 4096})
(mod "gametype:campaign_capture_the_flag" {limit 4096})
		; UFB: identical mp/not-mp defaults consolidated above.
		{remove dissolve}
		{DeadVehicles}
	}

	{group "piece" gameentity
		{limit 9999}
(mod "gametype:battle_zones" {limit 4096})
(mod "gametype:ammunition" {limit 4096})
(mod "gametype:evacuation" {limit 4096})
(mod "gametype:frontlines" {limit 4096})
(mod "gametype:campaign_capture_the_flag" {limit 4096})
		; UFB: identical mp/not-mp defaults consolidated above.
		{remove dissolve}
		{entity "piece_big_steel"}				;// cannon parts
		{entity "piece_large_steel"}			;// tank turret, ship parts
		{entity "piece_big_airborne"}			;// airborne parts
		{entity "piece_big_airborne_wing"}		;// airborne parts
	}

	{group "piece_large" gameentity
		{limit 9999}
(mod "gametype:battle_zones" {limit 2048})
(mod "gametype:ammunition" {limit 2048})
(mod "gametype:evacuation" {limit 2048})
(mod "gametype:frontlines" {limit 2048})
(mod "gametype:campaign_capture_the_flag" {limit 2048})
		; UFB: identical mp/not-mp defaults consolidated above.
		{remove dissolve}
		{entity "building_part_concrete"}		;// parts
		{entity "building_part_wood"}			;// parts
		{entity "piece_big_concrete"}			;// parts
		{entity "piece_big_stone"}				;// parts
		{entity "piece_big_wood"}				;// parts
		{entity "piece_large_concrete"}			;// parts
	}

	{group "piece_medium" gameentity
		{limit 9999}
(mod "gametype:battle_zones" {limit 1024})
(mod "gametype:ammunition" {limit 1024})
(mod "gametype:evacuation" {limit 1024})
(mod "gametype:frontlines" {limit 1024})
(mod "gametype:campaign_capture_the_flag" {limit 1024})
		; UFB: identical mp/not-mp defaults consolidated above.
		{remove dissolve}
		{entity "piece_medium_concrete"}
		{entity "piece_medium_ice"}
		{entity "piece_medium_sand"}
		{entity "piece_medium_steel"}
		{entity "piece_medium_steel_construction"}
		{entity "piece_medium_wood"}
	}

	{group "piece_small" gameentity
		{limit 9999}
(mod "gametype:battle_zones" {limit 512})
(mod "gametype:ammunition" {limit 512})
(mod "gametype:evacuation" {limit 512})
(mod "gametype:frontlines" {limit 512})
(mod "gametype:campaign_capture_the_flag" {limit 512})
		; UFB: identical mp/not-mp defaults consolidated above.
		{remove dissolve}
		{entity "piece_small_concrete"}
		{entity "piece_small_ice"}
		{entity "piece_small_steel"}
		{entity "piece_small_wood"}
		{entity "piece_tiny_steel"}
	}

	{group "mine" stuff
		(mod "mp" 		{limit 9999})
		(mod not "mp"	{limit 9999})
		{remove dissolve}
		{tag "grenade mine"}	;// hybrid AT grenade / mines
	}

	{group "stuff" stuff
		(mod "mp" 		{limit 9999})
		(mod not "mp"	{limit 9999})
		{remove dissolve}
		{tag "shell"}
		{tag "weapon bullet"}
		{tag "grenade"}
		{tag "missile"}		;// thrower hand weapon
		{tag "sharp_edge"}
	}

	{group "equip" stuff
		(mod "mp" 		{limit 9999})
		(mod not "mp"	{limit 9999})
		{remove dissolve}
		{tag "field_glass"}
		{tag "head"}
		{tag "body"}
	}

	{group "shellhole" gameentity
		(mod "mp" 		{limit 9999})
		(mod not "mp"	{limit 9999})
		{remove instant}
		{entity "grenade_shellhole"}
		{entity "grenade_at_shellhole"}
	}
	
	{group "shell_auto" stuff
		{limit 9999}
		{remove dissolve}
		{tag "shell_cannon_auto"}
	}

	{group "shell" stuff
		{limit 9999}
		{remove dissolve}
		{tag "shell_cannon"}
	}
}
